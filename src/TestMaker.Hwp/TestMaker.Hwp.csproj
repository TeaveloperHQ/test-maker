<Project Sdk="Microsoft.NET.Sdk">

  <!-- 설치된 한글(HWPFrame.HwpObject)을 COM 자동화로 구동해 문서를 만드는 부분 -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TestMaker.Core\TestMaker.Core.csproj" />
  </ItemGroup>

  <!-- 내장 기본 양식(forms/default)을 프로그램 옆에 함께 둔다. 다시 만들기: testmaker build-default-form forms/default -->
  <ItemGroup>
    <None Include="..\..\forms\**\*" Link="forms\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
