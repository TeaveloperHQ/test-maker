<Window x:Class="TestMaker.App.OriginalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="원문 보기" Width="800" Height="900" MinWidth="480" MinHeight="400"
        FontFamily="{StaticResource UiFont}" FontSize="14" Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
        Icon="/icon.ico" WindowStartupLocation="CenterOwner" UseLayoutRounding="True">
  <DockPanel Margin="20">
    <TextBlock DockPanel.Dock="Top" x:Name="TitleText" FontSize="18" FontWeight="Bold" Foreground="{StaticResource GradText}"
               TextTrimming="CharacterEllipsis" Margin="0,0,0,4" />
    <TextBlock DockPanel.Dock="Top" x:Name="SourceText" Style="{StaticResource Hint}" Margin="0,0,0,12" />

    <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
      <Button DockPanel.Dock="Right" Content="닫기" IsCancel="True" Click="Close_Click" Margin="0" Padding="18,7" />
      <StackPanel Orientation="Horizontal">
        <Button x:Name="TranscribeButton" Content="원문 다시 옮기기" Click="Transcribe_Click" Margin="0,0,8,0" Visibility="Collapsed"
                ToolTip="이 자료 문항들의 원문을 옮깁니다(문항 목록과 만든 결과는 그대로)." />
        <Button x:Name="OpenSourceButton" Content="자료 열기" Click="OpenSource_Click" ToolTip="원래 자료 파일(그림·PDF)을 엽니다." />
      </StackPanel>
    </DockPanel>

    <Border Style="{StaticResource Card}">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <Border x:Name="NoticeBox" Background="{StaticResource AccentSoft}" CornerRadius="8" Padding="12,10" Margin="0,0,0,12" Visibility="Collapsed">
            <StackPanel>
              <TextBlock x:Name="NoticeText" TextWrapping="Wrap" Foreground="{StaticResource Text2}" />
              <ProgressBar x:Name="Working" IsIndeterminate="True" Margin="0,8,0,0" Visibility="Collapsed" />
            </StackPanel>
          </Border>

          <!-- 원문 그대로: 자료에서 이 문항 영역만 잘라 낸 그림 -->
          <TextBlock x:Name="SnapshotLabel" Text="원문 그대로" Style="{StaticResource Hint}" FontWeight="SemiBold" Margin="0,0,0,4" Visibility="Collapsed" />
          <Border x:Name="SnapshotBox" BorderBrush="{StaticResource Line}" BorderThickness="1" HorizontalAlignment="Left" Visibility="Collapsed">
            <Image x:Name="SnapshotImage" MaxWidth="720" />
          </Border>

          <!-- 옮긴 글(원문항) -->
          <TextBlock x:Name="TextLabel" Text="옮긴 글" Style="{StaticResource Hint}" FontWeight="SemiBold" Margin="0,16,0,4" Visibility="Collapsed" />
          <TextBlock x:Name="TopText" TextWrapping="Wrap" LineHeight="24" />
          <Image x:Name="FigureImage" MaxWidth="560" HorizontalAlignment="Left" Margin="0,8" />
          <TextBlock x:Name="BottomText" TextWrapping="Wrap" LineHeight="24" />
          <Border x:Name="AnswerBox" Background="{StaticResource AccentSoft}" CornerRadius="8" Padding="12,10" Margin="0,14,0,0" Visibility="Collapsed">
            <TextBlock x:Name="AnswerText" TextWrapping="Wrap" Foreground="{StaticResource Text2}" FontSize="13" LineHeight="20" />
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Border>
  </DockPanel>
</Window>
