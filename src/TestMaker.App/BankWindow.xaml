<Window x:Class="TestMaker.App.BankWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="문항함" Width="1180" Height="800" MinWidth="900" MinHeight="560"
        FontFamily="{StaticResource UiFont}" FontSize="13.5" Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
        Icon="/icon.ico" WindowStartupLocation="CenterOwner" UseLayoutRounding="True">
  <DockPanel Margin="20">
    <!-- 위: 칸 고르기 + 찾기 -->
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
      <TextBox x:Name="SearchBox" DockPanel.Dock="Right" Width="280" TextChanged="Filter_Changed"
               ToolTip="발문·보기·단원에 들어 있는 글로 찾습니다." />
      <TextBlock DockPanel.Dock="Right" Text="찾기" Style="{StaticResource Label}" />
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock Text="문항함" FontSize="20" FontWeight="Bold" Foreground="{StaticResource GradText}" Margin="0,0,18,0" VerticalAlignment="Center" />
        <RadioButton x:Name="AllTab" Style="{StaticResource Pill}" GroupName="cat" IsChecked="True" Checked="Filter_Changed" />
        <RadioButton x:Name="ExamTab" Style="{StaticResource Pill}" GroupName="cat" Checked="Filter_Changed" />
        <RadioButton x:Name="PracticeTab" Style="{StaticResource Pill}" GroupName="cat" Checked="Filter_Changed" />
      </StackPanel>
    </DockPanel>

    <!-- 아래: 고른 것 넣기 -->
    <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Padding="14" Margin="0,14,0,0">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="닫기" Click="Close_Click" Margin="8,0,0,0" />
        <Button DockPanel.Dock="Right" x:Name="PickButton" Content="고른 문항을 시험지에 넣기" Style="{StaticResource Primary}" Click="Pick_Click" Padding="18,9" />
        <TextBlock x:Name="PickedText" VerticalAlignment="Center" Foreground="{StaticResource Text2}"
                   Text="시험지에 넣을 문항을 체크하세요. 마우스 오른쪽 단추로 칸 옮기기·지우기." />
      </DockPanel>
    </Border>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1.2*" />
        <ColumnDefinition Width="18" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- 목록 -->
      <Border Style="{StaticResource Card}" Padding="10">
        <Grid>
          <ListBox x:Name="ItemList" BorderThickness="0" Background="Transparent" SelectionChanged="ItemList_SelectionChanged"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem">
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                      <Border x:Name="b" Background="Transparent" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10"
                              Padding="12,10" Margin="0,0,0,8">
                        <ContentPresenter />
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="b" Property="Background" Value="{StaticResource SoftBg}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                          <Setter TargetName="b" Property="Background" Value="{StaticResource AccentSoft}" />
                          <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}" />
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ContextMenu>
              <ContextMenu>
                <MenuItem Header="시험용으로 옮기기" Click="MoveExam_Click" />
                <MenuItem Header="예상문제로 옮기기" Click="MovePractice_Click" />
                <Separator />
                <MenuItem Header="지우기…" Click="Delete_Click" />
              </ContextMenu>
            </ListBox.ContextMenu>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <DockPanel>
                  <CheckBox DockPanel.Dock="Left" IsChecked="{Binding Picked}" VerticalAlignment="Top" Margin="0,2,10,0" />
                  <Image DockPanel.Dock="Right" Source="{Binding Thumb}" MaxWidth="110" MaxHeight="70" Margin="10,0,0,0" VerticalAlignment="Top" />
                  <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                      <Border Style="{StaticResource Badge}" Background="{Binding BadgeBrush}">
                        <TextBlock Text="{Binding Category}" Foreground="White" FontSize="11.5" FontWeight="SemiBold" />
                      </Border>
                      <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding Snippet}" TextWrapping="Wrap" MaxHeight="40" TextTrimming="CharacterEllipsis" Foreground="{StaticResource Text2}" />
                    <TextBlock Text="{Binding Info}" Style="{StaticResource Hint}" FontSize="12" Margin="0,4,0,0" />
                  </StackPanel>
                </DockPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock x:Name="EmptyText" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource Hint}" TextAlignment="Center"
                     Text="보관한 문항이 없습니다.&#10;문항을 만든 뒤 ③에서 [시험용으로 보관]·[예상문제로 보관]을 누르세요." />
        </Grid>
      </Border>

      <!-- 미리보기 -->
      <Border Grid.Column="2" Style="{StaticResource Card}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel x:Name="PreviewPanel">
            <TextBlock x:Name="PvTitle" FontWeight="SemiBold" Foreground="{StaticResource Accent}" TextWrapping="Wrap" Margin="0,0,0,8" />
            <TextBlock x:Name="PvTop" TextWrapping="Wrap" LineHeight="21" />
            <Image x:Name="PvImage" MaxWidth="380" HorizontalAlignment="Left" Margin="0,8" />
            <TextBlock x:Name="PvBottom" TextWrapping="Wrap" LineHeight="21" />
            <Border x:Name="PvAnswerBox" Background="{StaticResource AccentSoft}" CornerRadius="8" Padding="10,8" Margin="0,10,0,0" Visibility="Collapsed">
              <TextBlock x:Name="PvAnswer" TextWrapping="Wrap" Foreground="{StaticResource Text2}" FontSize="12.5" LineHeight="19" />
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>
  </DockPanel>
</Window>
