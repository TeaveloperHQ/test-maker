<Window x:Class="TestMaker.App.JobListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="작업 목록" Width="680" Height="560" MinWidth="520" MinHeight="400"
        FontFamily="{StaticResource UiFont}" FontSize="13.5" Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
        Icon="/icon.ico" WindowStartupLocation="CenterOwner" UseLayoutRounding="True">
  <DockPanel Margin="20">
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
      <Button DockPanel.Dock="Right" Content="새 작업…" Style="{StaticResource Primary}" Click="New_Click" Padding="16,8" />
      <StackPanel>
        <TextBlock Text="작업 목록" FontSize="20" FontWeight="Bold" Foreground="{StaticResource GradText}" />
        <TextBlock Style="{StaticResource Hint}" Text="작업을 열면 자료·문항·결과·시험지 목록이 그대로 돌아옵니다." />
      </StackPanel>
    </DockPanel>

    <DockPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
      <Button DockPanel.Dock="Right" x:Name="OpenButton" Content="열기" Style="{StaticResource Primary}" Click="Open_Click" Padding="22,8" IsEnabled="False" />
      <Button DockPanel.Dock="Right" Content="닫기" IsCancel="True" Margin="0,0,8,0" />
      <StackPanel Orientation="Horizontal">
        <Button x:Name="EditButton" Content="고치기…" Click="Edit_Click" IsEnabled="False" ToolTip="이름·학년·과목을 바꿉니다." />
        <Button x:Name="CopyButton" Content="복제…" Click="Copy_Click" IsEnabled="False" ToolTip="새 이름으로 복사합니다(만든 시험지 파일은 빼고)." />
        <Button x:Name="DeleteButton" Content="지우기…" Click="Delete_Click" IsEnabled="False" Foreground="{StaticResource Danger}" ToolTip="휴지통으로 보냅니다." />
        <Button x:Name="FolderButton" Content="폴더 보기" Click="Folder_Click" IsEnabled="False" />
      </StackPanel>
    </DockPanel>

    <Border Style="{StaticResource Card}" Padding="10">
      <Grid>
        <ListBox x:Name="JobList" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch"
                 SelectionChanged="JobList_SelectionChanged" MouseDoubleClick="JobList_MouseDoubleClick">
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="b" Background="Transparent" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10"
                            Padding="14,10" Margin="0,0,0,8">
                      <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="b" Property="Background" Value="{StaticResource SoftBg}" />
                      </Trigger>
                      <Trigger Property="IsSelected" Value="True">
                        <Setter TargetName="b" Property="Background" Value="{StaticResource AccentSoft}" />
                        <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ContextMenu>
            <ContextMenu>
              <MenuItem Header="열기" Click="Open_Click" FontWeight="SemiBold" />
              <MenuItem Header="고치기…" Click="Edit_Click" />
              <MenuItem Header="복제…" Click="Copy_Click" />
              <MenuItem Header="폴더 보기" Click="Folder_Click" />
              <Separator />
              <MenuItem Header="지우기(휴지통)…" Click="Delete_Click" />
            </ContextMenu>
          </ListBox.ContextMenu>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding When}" Style="{StaticResource Hint}" VerticalAlignment="Top" />
                <StackPanel>
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14.5" />
                    <Border Style="{StaticResource Badge}" Background="{StaticResource AccentSoft}" Margin="8,0,0,0" Visibility="{Binding CurrentVisibility}">
                      <TextBlock Text="지금 작업" Foreground="{StaticResource Accent}" FontSize="11.5" FontWeight="SemiBold" />
                    </Border>
                  </StackPanel>
                  <TextBlock Text="{Binding Detail}" Style="{StaticResource Hint}" Margin="0,3,0,0" />
                </StackPanel>
              </DockPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock x:Name="EmptyText" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource Hint}" TextAlignment="Center"
                   Text="아직 작업이 없습니다. [새 작업…]으로 시작하세요." Visibility="Collapsed" />
      </Grid>
    </Border>
  </DockPanel>
</Window>
