<Project Sdk="Microsoft.NET.Sdk">

  <!-- 선생님용 윈도우 프로그램: 자료 → 문항 찾기 → 변형 → 시험지 -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>TestMaker</AssemblyName>
    <RootNamespace>TestMaker.App</RootNamespace>
    <!-- 아이콘: assets/icon.svg·icon-small.svg → tools/build-icon.ps1 → assets/icon.ico (teaveloper 공용 규격) -->
    <ApplicationIcon>..\..\assets\icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="..\..\assets\icon.ico" Link="icon.ico" />
    <Resource Include="..\..\assets\icon-128.png" Link="icon-128.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TestMaker.Core\TestMaker.Core.csproj" />
    <ProjectReference Include="..\TestMaker.Hwp\TestMaker.Hwp.csproj" />
    <ProjectReference Include="..\TestMaker.Ai\TestMaker.Ai.csproj" />
  </ItemGroup>

</Project>
