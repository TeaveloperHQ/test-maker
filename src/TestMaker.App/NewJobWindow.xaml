<Window x:Class="TestMaker.App.NewJobWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="새 작업" Width="460" SizeToContent="Height" ResizeMode="NoResize"
        FontFamily="{StaticResource UiFont}" FontSize="13.5" Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
        Icon="/icon.ico" WindowStartupLocation="CenterOwner" UseLayoutRounding="True" FocusManager.FocusedElement="{Binding ElementName=NameBox}">
  <Border Style="{StaticResource Card}" Margin="18">
    <StackPanel>
      <TextBlock x:Name="HeaderText" Text="새 작업" FontSize="18" FontWeight="Bold" Foreground="{StaticResource GradText}" Margin="0,0,0,4" />
      <TextBlock x:Name="HintText" Style="{StaticResource Hint}" Margin="0,0,0,16"
                 Text="시험 하나를 작업 하나로 만듭니다. 자료·문항·시험지가 모두 이 작업에 저장되어 언제든 다시 열어 이어서 할 수 있습니다." />
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition /><RowDefinition /><RowDefinition />
        </Grid.RowDefinitions>
        <TextBlock Text="작업 이름" Style="{StaticResource Label}" Margin="0,0,10,10" />
        <TextBox x:Name="NameBox" Grid.Column="1" Margin="0,0,0,10" ToolTip="예: 2026 2학기 1차고사, 3학년 열 단원 예상문제" />
        <TextBlock Grid.Row="1" Text="학년" Style="{StaticResource Label}" Margin="0,0,10,10" />
        <TextBox x:Name="GradeBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,10" ToolTip="예: 3학년" />
        <TextBlock Grid.Row="2" Text="과목" Style="{StaticResource Label}" Margin="0,0,10,0" />
        <TextBox x:Name="SubjectBox" Grid.Row="2" Grid.Column="1" Text="과학" />
      </Grid>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
        <Button Content="취소" IsCancel="True" Margin="0,0,8,0" />
        <Button x:Name="OkButton" Content="만들기" Style="{StaticResource Primary}" IsDefault="True" Click="Create_Click" Padding="22,9" />
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
