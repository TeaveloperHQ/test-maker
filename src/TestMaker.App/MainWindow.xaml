<Window x:Class="TestMaker.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TestMaker.App"
        Title="Test Maker — 문항 변형 시험지" Width="1360" Height="860" MinWidth="1000" MinHeight="640"
        FontFamily="Malgun Gothic" FontSize="13" Background="White"
        WindowStartupLocation="CenterScreen">
  <Window.InputBindings>
    <KeyBinding Key="V" Modifiers="Control" Command="ApplicationCommands.Paste" />
  </Window.InputBindings>
  <Window.CommandBindings>
    <CommandBinding Command="ApplicationCommands.Paste" Executed="Paste_Executed" />
  </Window.CommandBindings>

  <DockPanel>
    <!-- 위: 작업 -->
    <Border DockPanel.Dock="Top" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="16,10">
      <DockPanel>
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
          <Button Content="새 작업" Click="NewJob_Click" />
          <Button Content="작업 열기…" Click="OpenJob_Click" />
          <Button Content="작업 폴더 열기" Click="OpenFolder_Click" Margin="0" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="Test Maker" FontSize="18" FontWeight="Bold" Foreground="{StaticResource Accent}" />
          <TextBlock x:Name="JobText" Margin="16,0,0,0" VerticalAlignment="Center" Style="{StaticResource Hint}" />
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- 아래: 진행 상황 -->
    <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="16,6">
      <DockPanel>
        <Button x:Name="CancelButton" DockPanel.Dock="Right" Content="중지" Click="Cancel_Click" IsEnabled="False" Margin="0" />
        <ProgressBar x:Name="Busy" DockPanel.Dock="Right" Width="160" Height="10" Margin="0,0,12,0" Visibility="Hidden" IsIndeterminate="True" />
        <TextBlock x:Name="StatusText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="자료를 넣고 시작하세요." />
      </DockPanel>
    </Border>

    <Grid Margin="16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="240" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="1.3*" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- ① 자료 -->
      <DockPanel Grid.Column="0">
        <TextBlock DockPanel.Dock="Top" Text="① 자료" Style="{StaticResource Step}" />
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Margin="0,0,0,8"
                   Text="문항 그림·PDF·한글 파일을 끌어다 놓거나, 캡처한 그림을 Ctrl+V로 붙여 넣으세요." />
        <Button DockPanel.Dock="Bottom" x:Name="FindButton" Content="문항 찾기 ▶" Style="{StaticResource Primary}" Click="Find_Click" Margin="0,8,0,0" />
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
          <Button Content="파일 추가…" Click="AddFiles_Click" />
          <Button Content="붙여넣기" Command="ApplicationCommands.Paste" />
          <Button Content="빼기" Click="RemoveSource_Click" Margin="0" />
        </StackPanel>
        <Border BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="4">
          <Grid>
            <ListBox x:Name="SourceList" AllowDrop="True" Drop="Sources_Drop" DragOver="Sources_DragOver" BorderThickness="0"
                     SelectionChanged="SourceList_SelectionChanged">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Name}" Margin="2,4" TextTrimming="CharacterEllipsis" />
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="DropHint" Text="여기에 끌어다 놓기" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="#98A2B3" IsHitTestVisible="False" />
          </Grid>
        </Border>
      </DockPanel>

      <!-- ② 문항 고르기 -->
      <DockPanel Grid.Column="2">
        <TextBlock DockPanel.Dock="Top" Text="② 문항 고르기와 변형 수" Style="{StaticResource Step}" />
        <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,8"
                MaxHeight="200" x:Name="PreviewBox" Visibility="Collapsed">
          <Image x:Name="SourcePreview" Stretch="Uniform" />
        </Border>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
          <WrapPanel Margin="0,0,0,6">
            <TextBlock Text="모든 문항 변형 수" VerticalAlignment="Center" Margin="0,0,6,0" />
            <ComboBox x:Name="AllVariants" Width="54" SelectedIndex="1" />
            <Button Content="적용" Click="ApplyAll_Click" Margin="6,0,16,0" />
            <TextBlock Text="변형 방식" VerticalAlignment="Center" Margin="0,0,6,0" />
            <ComboBox x:Name="StyleBox" Width="140" />
          </WrapPanel>
          <DockPanel>
            <TextBlock Text="추가 요청" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBox x:Name="RequestBox" Padding="4" ToolTip="예: 그래프 문항으로 바꿔 줘 / 난이도를 조금 높여 줘" />
          </DockPanel>
          <Button x:Name="MakeButton" Content="변형 만들기 ▶" Style="{StaticResource Primary}" Click="Make_Click" Margin="0,8,0,0" />
        </StackPanel>
        <DataGrid x:Name="QuestionGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource Line}"
                  BorderBrush="{StaticResource Line}" MinRowHeight="30" SelectionMode="Single" VerticalContentAlignment="Center">
          <DataGrid.Columns>
            <DataGridCheckBoxColumn Header="사용" Binding="{Binding Include, UpdateSourceTrigger=PropertyChanged}" Width="44" />
            <DataGridTextColumn Header="번호" Binding="{Binding Number}" IsReadOnly="True" Width="44" />
            <DataGridTextColumn Header="내용" Binding="{Binding Summary}" IsReadOnly="True" Width="*">
              <DataGridTextColumn.ElementStyle>
                <Style TargetType="TextBlock">
                  <Setter Property="TextWrapping" Value="Wrap" />
                  <Setter Property="Margin" Value="2,4" />
                </Style>
              </DataGridTextColumn.ElementStyle>
            </DataGridTextColumn>
            <DataGridTextColumn Header="유형" Binding="{Binding TypeText}" IsReadOnly="True" Width="54" />
            <DataGridCheckBoxColumn Header="그림" Binding="{Binding HasFigure}" IsReadOnly="True" Width="44" />
            <DataGridCheckBoxColumn Header="원문항" Binding="{Binding KeepOriginal, UpdateSourceTrigger=PropertyChanged}" Width="54" />
            <DataGridTemplateColumn Header="변형 수" Width="64">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <ComboBox SelectedItem="{Binding Variants, UpdateSourceTrigger=PropertyChanged}" ItemsSource="{x:Static local:Choices.Counts}" Margin="2" VerticalAlignment="Center" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="상태" Binding="{Binding Status}" IsReadOnly="True" Width="64" />
          </DataGrid.Columns>
          <DataGrid.ContextMenu>
            <ContextMenu>
              <MenuItem Header="이 문항 다시 만들기" Click="Remake_Click" />
            </ContextMenu>
          </DataGrid.ContextMenu>
        </DataGrid>
      </DockPanel>

      <!-- ③ 결과 → 시험지 -->
      <DockPanel Grid.Column="4">
        <TextBlock DockPanel.Dock="Top" Text="③ 결과 확인과 시험지" Style="{StaticResource Step}" />
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Panel}" CornerRadius="4" Padding="10" Margin="0,8,0,0">
          <StackPanel>
            <Grid Margin="0,0,0,6">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition /><RowDefinition /><RowDefinition />
              </Grid.RowDefinitions>
              <TextBlock Text="시험 이름" VerticalAlignment="Center" Margin="0,0,6,4" />
              <TextBox x:Name="TitleBox" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,0,0,4" Padding="3" />
              <TextBlock Grid.Row="1" Text="과목" VerticalAlignment="Center" Margin="0,0,6,4" />
              <TextBox x:Name="SubjectBox" Grid.Row="1" Grid.Column="1" Margin="0,0,8,4" Padding="3" Text="과학" />
              <TextBlock Grid.Row="1" Grid.Column="2" Text="학년" VerticalAlignment="Center" Margin="0,0,6,4" />
              <TextBox x:Name="GradeBox" Grid.Row="1" Grid.Column="3" Margin="0,0,0,4" Padding="3" />
              <TextBlock Grid.Row="2" Text="일시" VerticalAlignment="Center" Margin="0,0,6,0" />
              <TextBox x:Name="DateBox" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Padding="3" />
            </Grid>
            <DockPanel Margin="0,0,0,8">
              <TextBlock Text="양식" VerticalAlignment="Center" Margin="0,0,6,0" />
              <Button DockPanel.Dock="Right" Content="학교 양식 학습…" Click="LearnForm_Click" Margin="6,0,0,0" />
              <ComboBox x:Name="FormBox" DisplayMemberPath="Name" />
            </DockPanel>
            <WrapPanel Margin="0,0,0,8">
              <CheckBox x:Name="PdfCheck" Content="PDF도" IsChecked="True" Margin="0,0,12,0" />
              <CheckBox x:Name="AnswersCheck" Content="정답·해설지도" IsChecked="True" />
            </WrapPanel>
            <Button x:Name="RenderButton" Content="시험지 만들기 ▶" Style="{StaticResource Primary}" Click="Render_Click" Margin="0" />
          </StackPanel>
        </Border>
        <Border BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="4">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="ResultList" Margin="8">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="0,8">
                    <StackPanel>
                      <CheckBox IsChecked="{Binding Include}" FontWeight="SemiBold" Content="{Binding Title}" Margin="0,0,0,4" />
                      <TextBlock Text="{Binding Top}" TextWrapping="Wrap" />
                      <Image Source="{Binding Image}" MaxWidth="320" MaxHeight="240" HorizontalAlignment="Left" Margin="0,4" />
                      <TextBlock Text="{Binding Bottom}" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding Answer}" TextWrapping="Wrap" Foreground="#B54708" Margin="0,4,0,0" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Border>
      </DockPanel>
    </Grid>
  </DockPanel>
</Window>
