<Window x:Class="TestMaker.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TestMaker.App"
        Title="Test Maker — 참고 문항으로 변형 시험지" Width="1500" Height="900" MinWidth="1280" MinHeight="680" WindowState="Maximized"
        FontFamily="{StaticResource UiFont}" FontSize="13.5" Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
        Icon="/icon.ico" WindowStartupLocation="CenterScreen" UseLayoutRounding="True">
  <Window.InputBindings>
    <KeyBinding Key="V" Modifiers="Control" Command="ApplicationCommands.Paste" />
  </Window.InputBindings>
  <Window.CommandBindings>
    <CommandBinding Command="ApplicationCommands.Paste" Executed="Paste_Executed" />
  </Window.CommandBindings>

  <DockPanel>
    <!-- 머리: 로고 + 워드마크 + 작업 -->
    <Border DockPanel.Dock="Top" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="24,12">
      <DockPanel>
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
          <Button Content="문항함" Click="OpenBank_Click" FontWeight="SemiBold" Foreground="{StaticResource Accent}" BorderBrush="{StaticResource Accent}" Margin="0,0,16,0" />
          <Button Content="작업 목록…" Click="OpenJob_Click" />
          <Button Content="새 작업…" Click="NewJob_Click" />
          <Button Content="작업 폴더" Click="OpenFolder_Click" Margin="0" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Image Source="/icon-128.png" Width="38" Height="38" RenderOptions.BitmapScalingMode="HighQuality" />
          <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="Test Maker" FontSize="20" FontWeight="Bold" Foreground="{StaticResource GradText}" />
              <TextBlock Text="│" FontSize="18" Foreground="{StaticResource LineStrong}" Margin="12,0" VerticalAlignment="Center" />
              <TextBlock x:Name="JobNameText" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock x:Name="JobText" Style="{StaticResource Hint}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxWidth="760" />
          </StackPanel>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- 바닥: 진행 상황 -->
    <Border DockPanel.Dock="Bottom" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="24,10">
      <DockPanel>
        <Button x:Name="CancelButton" DockPanel.Dock="Right" Content="중지" Click="Cancel_Click" IsEnabled="False" Margin="0" />
        <ProgressBar x:Name="Busy" DockPanel.Dock="Right" Width="180" Margin="0,0,14,0" Visibility="Hidden" IsIndeterminate="True" />
        <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="{StaticResource Text2}" TextTrimming="CharacterEllipsis"
                   Text="자료를 넣고 시작하세요." />
      </DockPanel>
    </Border>

    <Grid Margin="20">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="240" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="1.4*" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="310" />
      </Grid.ColumnDefinitions>

      <!-- ① 자료 -->
      <Border Grid.Column="0" Style="{StaticResource Card}">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
            <Border Style="{StaticResource StepBadge}">
              <TextBlock Text="1" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="자료" Style="{StaticResource StepTitle}" />
          </StackPanel>
          <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Margin="0,0,0,12"
                     Text="참고할 문항의 그림·PDF·한글 파일을 넣으세요(캡처 뒤 Ctrl+V도 됨). 언제든 더 넣거나 뺄 수 있고, [문항 찾기]는 새로 넣은 자료만 읽습니다." />
          <Button DockPanel.Dock="Bottom" x:Name="FindButton" Content="문항 찾기" Style="{StaticResource Primary}" Click="Find_Click" Margin="0,12,0,0" />
          <UniformGrid DockPanel.Dock="Bottom" Rows="1" Margin="0,12,0,0">
            <Button Content="파일 추가" Click="AddFiles_Click" Padding="2,6" FontSize="12.5" Margin="0,0,4,0" />
            <Button Content="붙여넣기" Command="ApplicationCommands.Paste" Padding="2,6" FontSize="12.5" Margin="0,0,4,0" />
            <Button Content="빼기" Click="RemoveSource_Click" Padding="2,6" FontSize="12.5" Margin="0" />
          </UniformGrid>
          <Grid>
            <Rectangle RadiusX="12" RadiusY="12" Fill="{StaticResource GradSoft}" Stroke="{StaticResource LineStrong}"
                       StrokeThickness="1.5" StrokeDashArray="4 3" />
            <ListBox x:Name="SourceList" Style="{StaticResource SoftList}" Margin="8" AllowDrop="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     Drop="Sources_Drop" DragOver="Sources_DragOver" SelectionChanged="SourceList_SelectionChanged">
              <ListBox.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="이 자료에서 문항 다시 찾기" Click="RefindSource_Click" />
                  <Separator />
                  <MenuItem Header="자료 빼기…" Click="RemoveSource_Click" />
                </ContextMenu>
              </ListBox.ContextMenu>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <StackPanel>
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                    <TextBlock FontSize="11.5">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Hint}">
                          <Setter Property="Text" Value="새 자료 · [문항 찾기]를 누르세요" />
                          <Setter Property="Foreground" Value="{StaticResource Accent}" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding Analyzed}" Value="True">
                              <Setter Property="Text" Value="문항 찾음" />
                              <Setter Property="Foreground" Value="{StaticResource Muted}" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel x:Name="DropHint" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
              <TextBlock Text="＋" FontSize="30" HorizontalAlignment="Center" Foreground="{StaticResource GradText}" />
              <TextBlock Text="여기에 끌어다 놓기" HorizontalAlignment="Center" Style="{StaticResource Hint}" />
            </StackPanel>
          </Grid>
        </DockPanel>
      </Border>

      <!-- ② 문항 고르기 -->
      <Border Grid.Column="2" Style="{StaticResource Card}">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
            <Border Style="{StaticResource StepBadge}">
              <TextBlock Text="2" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="문항 고르기와 변형 수" Style="{StaticResource StepTitle}" />
          </StackPanel>
          <Border DockPanel.Dock="Top" Background="{StaticResource GradSoft}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                  CornerRadius="8" Padding="10,5" Margin="0,0,0,8" HorizontalAlignment="Left">
            <TextBlock x:Name="ActiveSourceText2" FontWeight="SemiBold" Foreground="{StaticResource Accent}" TextTrimming="CharacterEllipsis" />
          </Border>
          <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Margin="0,0,0,10"
                     Text="①에서 고른 자료의 문항입니다. 문항마다 쓸지, 원문항도 넣을지, 어떻게 몇 개 변형할지 정하세요(변형 수는 ▾ 또는 숫자를 치고 ↑↓로 다음 문항). 다시 만들려면 마우스 오른쪽 단추." />

          <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Border Style="{StaticResource Panel}">
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <TextBlock Text="추가 요청" Style="{StaticResource Label}" Margin="0,0,10,0" />
                  <TextBox Grid.Column="1" x:Name="RequestBox" TextChanged="Settings_Changed" ToolTip="모든 문항에 적용됩니다. 예: 그래프 문항으로 바꿔 줘 / 난이도를 조금 높여 줘" />
                </Grid>
              </StackPanel>
            </Border>
            <Button x:Name="MakeButton" Content="변형 만들기" Style="{StaticResource Primary}" Click="Make_Click" Margin="0,12,0,0" />
          </StackPanel>

          <!-- 문항 카드: 원문이 다 보이게 그리고, 카드마다 사용·원문항·변형 방식·변형 수 -->
          <Grid>
            <TextBlock x:Name="QuestionEmpty" Panel.ZIndex="1" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource Hint}"
                       TextAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed" />
            <ScrollViewer x:Name="CardScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <ItemsControl x:Name="QuestionCards" PreviewKeyDown="QuestionCards_PreviewKeyDown">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                            CornerRadius="10" Padding="14,12" Margin="0,0,4,12">
                      <Border.ContextMenu>
                        <ContextMenu>
                          <MenuItem Header="이 문항 다시 만들기" Click="Remake_Click" />
                          <MenuItem Header="크게 보기" Click="ShowOriginal_Click" />
                        </ContextMenu>
                      </Border.ContextMenu>
                      <StackPanel>
                        <!-- 머리: 번호·요약·상태 -->
                        <DockPanel Margin="0,0,0,6">
                          <TextBlock DockPanel.Dock="Right" Text="{Binding Q.Status}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,0,0">
                            <TextBlock.Style>
                              <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource Muted}" />
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding Q.Status}" Value="완료"><Setter Property="Foreground" Value="#10B981" /></DataTrigger>
                                  <DataTrigger Binding="{Binding Q.Status}" Value="만드는 중"><Setter Property="Foreground" Value="{StaticResource Accent}" /></DataTrigger>
                                  <DataTrigger Binding="{Binding Q.Status}" Value="실패"><Setter Property="Foreground" Value="{StaticResource Danger}" /></DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </TextBlock.Style>
                          </TextBlock>
                          <Button DockPanel.Dock="Right" Content="크게" Style="{StaticResource SmallButton}" Click="ShowOriginal_Click" Tag="{Binding Q}" />
                          <TextBlock TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                            <Run Text="{Binding Q.Number, Mode=OneWay, StringFormat='{}{0}번'}" FontWeight="Bold" Foreground="{StaticResource Accent}" />
                            <Run Text="{Binding Q.Summary, Mode=OneWay}" Foreground="{StaticResource Text2}" />
                          </TextBlock>
                        </DockPanel>
                        <!-- 정하기 -->
                        <WrapPanel Margin="0,0,0,10">
                          <CheckBox Content="사용" IsChecked="{Binding Q.Include}" Margin="0,0,14,4" />
                          <CheckBox Content="원문항 넣기" IsChecked="{Binding Q.KeepOriginal}" Margin="0,0,14,4" />
                          <TextBlock Text="변형" Style="{StaticResource Label}" Margin="0,0,6,4" />
                          <ComboBox SelectedItem="{Binding Q.Style, UpdateSourceTrigger=PropertyChanged}" ItemsSource="{x:Static local:Choices.Styles}"
                                    Width="120" Padding="6,2" Margin="0,0,6,4" />
                          <ComboBox Tag="Variants" IsEditable="True" ItemsSource="{x:Static local:Choices.Counts}"
                                    Text="{Binding Q.Variants, UpdateSourceTrigger=PropertyChanged}" Width="56" Padding="6,2" Margin="0,0,4,4"
                                    GotKeyboardFocus="VariantsBox_GotKeyboardFocus" ToolTip="변형 수 — 숫자를 치고 ↑↓로 다음 문항" />
                          <TextBlock Text="개" Style="{StaticResource Label}" Margin="0,0,0,4" />
                        </WrapPanel>
                        <!-- 원문 그대로(자료에서 잘라 낸 그림) 또는 옮긴 글 -->
                        <Border BorderBrush="{StaticResource Line}" BorderThickness="1" HorizontalAlignment="Left" Visibility="{Binding SnapshotVisibility}">
                          <Image Source="{Binding Snapshot}" Stretch="Uniform" />
                        </Border>
                        <StackPanel Visibility="{Binding TextVisibility}">
                          <TextBlock Text="{Binding Top}" TextWrapping="Wrap" LineHeight="21" />
                          <Image Source="{Binding Figure}" MaxHeight="260" HorizontalAlignment="Left" Margin="0,6" />
                          <TextBlock Text="{Binding Bottom}" TextWrapping="Wrap" LineHeight="21" />
                        </StackPanel>
                        <DockPanel Visibility="{Binding MissingVisibility}">
                          <Button DockPanel.Dock="Right" Content="원문 옮기기" Style="{StaticResource SmallButton}" Click="CardTranscribe_Click" Tag="{Binding Q}"
                                  ToolTip="이 자료 문항들의 원문을 옮깁니다(1~3분, 한 번만 — 문항 목록과 만든 결과는 그대로)." />
                          <TextBlock Text="원문을 아직 옮기지 않은 문항입니다(예전에 찾은 문항)." Style="{StaticResource Hint}" VerticalAlignment="Center" />
                        </DockPanel>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Grid>
        </DockPanel>
      </Border>

      <!-- ③ 결과 확인: 문항마다 시험지 / 예상문제 / 버림 -->
      <Border Grid.Column="4" Style="{StaticResource Card}">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
            <Border Style="{StaticResource StepBadge}">
              <TextBlock Text="3" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="결과 확인과 행선지" Style="{StaticResource StepTitle}" />
          </StackPanel>
          <Border DockPanel.Dock="Top" Background="{StaticResource GradSoft}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                  CornerRadius="8" Padding="10,5" Margin="0,0,0,8" HorizontalAlignment="Left">
            <TextBlock x:Name="ActiveSourceText3" FontWeight="SemiBold" Foreground="{StaticResource Accent}" TextTrimming="CharacterEllipsis" />
          </Border>
          <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Margin="0,0,0,8"
                     Text="문항마다 시험지·예상문제 중 어디로 보낼지 고르세요. 고르지 않은 문항은 버려집니다. 보낸 문항은 문항함에도 자동으로 모입니다." />
          <Border DockPanel.Dock="Top" Style="{StaticResource Panel}" Padding="10,6" Margin="0,0,0,10">
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="모두" Style="{StaticResource Label}" />
                <Button Content="시험지로" Style="{StaticResource SmallButton}" Click="AllExam_Click" Foreground="{StaticResource ExamColor}" />
                <Button Content="예상문제로" Style="{StaticResource SmallButton}" Click="AllPractice_Click" Foreground="{StaticResource PracticeColor}" />
                <Button Content="버림" Style="{StaticResource SmallButton}" Click="AllNone_Click" />
              </StackPanel>
              <TextBlock x:Name="DestSummary" Style="{StaticResource Hint}" Margin="0,4,0,0" />
            </StackPanel>
          </Border>

          <Grid>
          <TextBlock x:Name="ResultEmpty" Panel.ZIndex="1" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource Hint}"
                     TextAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed" />
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="ResultList">
              <ItemsControl.GroupStyle>
                <GroupStyle>
                  <GroupStyle.HeaderTemplate>
                    <DataTemplate>
                      <TextBlock Margin="2,4,0,8">
                        <Run Text="📄" /> <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource Accent}" />
                      </TextBlock>
                    </DataTemplate>
                  </GroupStyle.HeaderTemplate>
                </GroupStyle>
              </ItemsControl.GroupStyle>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border x:Name="card" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                          CornerRadius="10" Padding="14,12" Margin="0,0,4,10">
                    <StackPanel>
                      <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{StaticResource Accent}" TextWrapping="Wrap" Margin="0,0,0,6" />
                      <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="보낼 곳" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <RadioButton Content="시험지" Style="{StaticResource Seg}" Tag="{StaticResource ExamColor}" GroupName="{Binding Key}" IsChecked="{Binding IsExam}" />
                        <RadioButton Content="예상문제" Style="{StaticResource Seg}" Tag="{StaticResource PracticeColor}" GroupName="{Binding Key}" IsChecked="{Binding IsPractice}" />
                        <RadioButton Content="버림" Style="{StaticResource Seg}" Tag="{StaticResource NoneColor}" GroupName="{Binding Key}" IsChecked="{Binding IsNone}" Margin="0" />
                      </StackPanel>
                      <TextBlock Text="{Binding Top}" TextWrapping="Wrap" LineHeight="21" />
                      <Image Source="{Binding Image}" MaxWidth="320" MaxHeight="240" HorizontalAlignment="Left" Margin="0,8" />
                      <TextBlock Text="{Binding Bottom}" TextWrapping="Wrap" LineHeight="21" />
                      <Border Background="{StaticResource AccentSoft}" CornerRadius="8" Padding="10,8" Margin="0,10,0,0">
                        <TextBlock Text="{Binding Answer}" TextWrapping="Wrap" Foreground="{StaticResource Text2}" FontSize="12.5" LineHeight="19" />
                      </Border>
                    </StackPanel>
                  </Border>
                  <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding Destination}" Value="시험지">
                      <Setter TargetName="card" Property="BorderBrush" Value="{StaticResource ExamColor}" />
                      <Setter TargetName="card" Property="BorderThickness" Value="2" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Destination}" Value="예상문제">
                      <Setter TargetName="card" Property="BorderBrush" Value="{StaticResource PracticeColor}" />
                      <Setter TargetName="card" Property="BorderThickness" Value="2" />
                    </DataTrigger>
                  </DataTemplate.Triggers>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          </Grid>
        </DockPanel>
      </Border>

      <!-- ④ 시험지 / 예상문제 (탭 두 개) -->
      <Border Grid.Column="6" Style="{StaticResource Card}">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
            <Border Style="{StaticResource StepBadge}">
              <TextBlock Text="4" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <RadioButton x:Name="ExamTab" Style="{StaticResource Pill}" GroupName="tab" IsChecked="True" Checked="Tab_Checked" Content="시험지" />
            <RadioButton x:Name="PracticeTab" Style="{StaticResource Pill}" GroupName="tab" Checked="Tab_Checked" Content="예상문제" />
          </StackPanel>
          <TextBlock x:Name="TabHint" DockPanel.Dock="Top" Style="{StaticResource Hint}" Margin="0,0,0,10" />
          <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <Button DockPanel.Dock="Right" Content="비우기" Click="ClearExam_Click" Margin="6,0,0,0" />
            <Button Content="문항함에서 넣기…" Click="AddFromBank_Click" Margin="0" />
          </DockPanel>

          <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <TextBlock x:Name="ExamSummary" Foreground="{StaticResource Text2}" FontWeight="SemiBold" Margin="2,0,0,8" />
            <Border Style="{StaticResource Panel}">
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                  </Grid.RowDefinitions>
                  <TextBlock x:Name="TitleLabel" Text="시험 이름" Style="{StaticResource Label}" Margin="0,0,8,8" />
                  <TextBox x:Name="TitleBox" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,0,0,8" TextChanged="Settings_Changed" />
                  <TextBlock Grid.Row="1" Text="과목" Style="{StaticResource Label}" Margin="0,0,8,8" />
                  <TextBox x:Name="SubjectBox" Grid.Row="1" Grid.Column="1" Margin="0,0,10,8" Text="과학" TextChanged="Settings_Changed" />
                  <TextBlock Grid.Row="1" Grid.Column="2" Text="학년" Style="{StaticResource Label}" Margin="0,0,8,8" />
                  <TextBox x:Name="GradeBox" Grid.Row="1" Grid.Column="3" Margin="0,0,0,8" TextChanged="Settings_Changed" />
                  <TextBlock Grid.Row="2" Text="일시" Style="{StaticResource Label}" Margin="0,0,8,8" />
                  <TextBox x:Name="DateBox" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,0,0,8" TextChanged="Settings_Changed" />
                  <TextBlock Grid.Row="3" Text="양식" Style="{StaticResource Label}" />
                  <DockPanel Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3">
                    <Button DockPanel.Dock="Right" Content="학습…" Click="LearnForm_Click" Margin="6,0,0,0" Padding="8,6" ToolTip="학교 시험지 양식(한글 파일)을 배워 목록에 넣습니다." />
                    <ComboBox x:Name="FormBox" DisplayMemberPath="Name" SelectionChanged="Settings_Changed" />
                  </DockPanel>
                </Grid>
                <WrapPanel Margin="0,10,0,0">
                  <CheckBox x:Name="PdfCheck" Content="PDF도" IsChecked="True" Margin="0,0,14,0" Click="Settings_Changed" />
                  <CheckBox x:Name="AnswersCheck" Content="정답·해설지도" IsChecked="True" Click="Settings_Changed" />
                </WrapPanel>
              </StackPanel>
            </Border>
            <Button x:Name="RenderButton" Content="시험지 만들기" Style="{StaticResource Primary}" Click="Render_Click" Margin="0,12,0,0" />
            <Button Content="만든 시험지 폴더" Click="ExamsFolder_Click" Margin="0,8,0,0" FontSize="12.5" Padding="8,5"
                    ToolTip="이 작업에서 만든 시험지·예상문제지(날짜별)를 엽니다." />
          </StackPanel>

          <Border BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10">
            <Grid>
              <ListBox x:Name="ExamList" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                  <Style TargetType="ListBoxItem">
                    <Setter Property="Template">
                      <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                          <Border x:Name="b" Background="Transparent" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="10,7">
                            <ContentPresenter />
                          </Border>
                          <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                              <Setter TargetName="b" Property="Background" Value="{StaticResource SoftBg}" />
                            </Trigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </Setter.Value>
                    </Setter>
                  </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <DockPanel>
                      <TextBlock DockPanel.Dock="Left" Text="{Binding Number}" FontWeight="Bold" Foreground="{StaticResource Accent}" Width="26" VerticalAlignment="Center" />
                      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="↑" Style="{StaticResource SmallButton}" Click="EntryUp_Click" Tag="{Binding}" ToolTip="앞으로" />
                        <Button Content="↓" Style="{StaticResource SmallButton}" Click="EntryDown_Click" Tag="{Binding}" ToolTip="뒤로" />
                        <Button Content="✕" Style="{StaticResource SmallButton}" Click="EntryRemove_Click" Tag="{Binding}" ToolTip="빼기(이번 작업 문항은 ③에서 '버림'이 됩니다)" />
                      </StackPanel>
                      <StackPanel>
                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Sub}" Style="{StaticResource Hint}" FontSize="11.5" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                    </DockPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <TextBlock x:Name="ExamEmpty" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource Hint}" TextAlignment="Center"
                         Text="아직 넣은 문항이 없습니다." />
            </Grid>
          </Border>
        </DockPanel>
      </Border>
    </Grid>
  </DockPanel>
</Window>
