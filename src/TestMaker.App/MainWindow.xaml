<Window x:Class="TestMaker.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TestMaker.App"
        Title="Test Maker — 참고 문항으로 변형 시험지" Width="1500" Height="900" MinWidth="1280" MinHeight="680" WindowState="Maximized"
        FontFamily="{StaticResource UiFont}" FontSize="13.5" Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
        Icon="/icon.ico" WindowStartupLocation="CenterScreen" UseLayoutRounding="True">
  <Window.InputBindings>
    <KeyBinding Key="V" Modifiers="Control" Command="ApplicationCommands.Paste" />
  </Window.InputBindings>
  <Window.CommandBindings>
    <CommandBinding Command="ApplicationCommands.Paste" Executed="Paste_Executed" />
  </Window.CommandBindings>

  <DockPanel>
    <!-- 머리: 로고 + 워드마크 + 작업 -->
    <Border DockPanel.Dock="Top" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="24,12">
      <DockPanel>
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
          <Button Content="문항함" Click="OpenBank_Click" FontWeight="SemiBold" Foreground="{StaticResource Accent}" BorderBrush="{StaticResource Accent}" Margin="0,0,16,0" />
          <Button Content="새 작업" Click="NewJob_Click" />
          <Button Content="작업 열기…" Click="OpenJob_Click" />
          <Button Content="작업 폴더" Click="OpenFolder_Click" Margin="0" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Image Source="/icon-128.png" Width="38" Height="38" RenderOptions.BitmapScalingMode="HighQuality" />
          <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="Test Maker" FontSize="20" FontWeight="Bold" Foreground="{StaticResource GradText}" />
            <TextBlock x:Name="JobText" Style="{StaticResource Hint}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxWidth="760" />
          </StackPanel>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- 바닥: 진행 상황 -->
    <Border DockPanel.Dock="Bottom" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="24,10">
      <DockPanel>
        <Button x:Name="CancelButton" DockPanel.Dock="Right" Content="중지" Click="Cancel_Click" IsEnabled="False" Margin="0" />
        <ProgressBar x:Name="Busy" DockPanel.Dock="Right" Width="180" Margin="0,0,14,0" Visibility="Hidden" IsIndeterminate="True" />
        <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="{StaticResource Text2}" TextTrimming="CharacterEllipsis"
                   Text="자료를 넣고 시작하세요." />
      </DockPanel>
    </Border>

    <Grid Margin="20">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="240" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="1.45*" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="330" />
      </Grid.ColumnDefinitions>

      <!-- ① 자료 -->
      <Border Grid.Column="0" Style="{StaticResource Card}">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
            <Border Style="{StaticResource StepBadge}">
              <TextBlock Text="1" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="자료" Style="{StaticResource StepTitle}" />
          </StackPanel>
          <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Margin="0,0,0,12"
                     Text="참고할 문항의 그림·PDF·한글 파일을 넣으세요. 화면 캡처(Win+Shift+S) 뒤 Ctrl+V도 됩니다." />
          <Button DockPanel.Dock="Bottom" x:Name="FindButton" Content="문항 찾기" Style="{StaticResource Primary}" Click="Find_Click" Margin="0,12,0,0" />
          <UniformGrid DockPanel.Dock="Bottom" Rows="1" Margin="0,12,0,0">
            <Button Content="파일 추가" Click="AddFiles_Click" Padding="2,6" FontSize="12.5" Margin="0,0,4,0" />
            <Button Content="붙여넣기" Command="ApplicationCommands.Paste" Padding="2,6" FontSize="12.5" Margin="0,0,4,0" />
            <Button Content="빼기" Click="RemoveSource_Click" Padding="2,6" FontSize="12.5" Margin="0" />
          </UniformGrid>
          <Grid>
            <Rectangle RadiusX="12" RadiusY="12" Fill="{StaticResource GradSoft}" Stroke="{StaticResource LineStrong}"
                       StrokeThickness="1.5" StrokeDashArray="4 3" />
            <ListBox x:Name="SourceList" Style="{StaticResource SoftList}" Margin="8" AllowDrop="True"
                     Drop="Sources_Drop" DragOver="Sources_DragOver" SelectionChanged="SourceList_SelectionChanged">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel x:Name="DropHint" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
              <TextBlock Text="＋" FontSize="30" HorizontalAlignment="Center" Foreground="{StaticResource GradText}" />
              <TextBlock Text="여기에 끌어다 놓기" HorizontalAlignment="Center" Style="{StaticResource Hint}" />
            </StackPanel>
          </Grid>
        </DockPanel>
      </Border>

      <!-- ② 문항 고르기 -->
      <Border Grid.Column="2" Style="{StaticResource Card}">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
            <Border Style="{StaticResource StepBadge}">
              <TextBlock Text="2" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="문항 고르기와 변형 수" Style="{StaticResource StepTitle}" />
          </StackPanel>
          <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Margin="0,0,0,12"
                     Text="문항마다 쓸지, 원문항도 넣을지, 어떻게 몇 개 변형할지 정하세요. 변형 수는 ▾에서 고르거나 숫자를 쳐 넣고 ↑↓로 다음 문항. 다시 만들려면 마우스 오른쪽 단추." />
          <Border DockPanel.Dock="Top" x:Name="PreviewBox" Visibility="Collapsed" Style="{StaticResource Panel}" Margin="0,0,0,12" MaxHeight="210">
            <Image x:Name="SourcePreview" Stretch="Uniform" />
          </Border>

          <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Border Style="{StaticResource Panel}">
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <TextBlock Text="추가 요청" Style="{StaticResource Label}" Margin="0,0,10,0" />
                  <TextBox Grid.Column="1" x:Name="RequestBox" ToolTip="모든 문항에 적용됩니다. 예: 그래프 문항으로 바꿔 줘 / 난이도를 조금 높여 줘" />
                </Grid>
              </StackPanel>
            </Border>
            <Button x:Name="MakeButton" Content="변형 만들기" Style="{StaticResource Primary}" Click="Make_Click" Margin="0,12,0,0" />
          </StackPanel>

          <Border BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="1">
            <DataGrid x:Name="QuestionGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                      CanUserResizeRows="False" MinRowHeight="36" SelectionMode="Single" SelectionUnit="Cell"
                      PreviewKeyDown="QuestionGrid_PreviewKeyDown">
              <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="사용" Binding="{Binding Include, UpdateSourceTrigger=PropertyChanged}" Width="40" />
                <DataGridTextColumn Header="번호" Binding="{Binding Number}" IsReadOnly="True" Width="40" />
                <DataGridTemplateColumn Header="내용" Width="*">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <StackPanel Margin="0,6">
                        <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" />
                        <TextBlock Style="{StaticResource Hint}" FontSize="12">
                          <Run Text="{Binding TypeText, Mode=OneWay}" /><Run Text="{Binding FigureText, Mode=OneWay}" />
                        </TextBlock>
                      </StackPanel>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridCheckBoxColumn Header="원문항" Binding="{Binding KeepOriginal, UpdateSourceTrigger=PropertyChanged}" Width="50" />
                <DataGridTemplateColumn Header="변형 방식" Width="118">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <ComboBox SelectedItem="{Binding Style, UpdateSourceTrigger=PropertyChanged}" ItemsSource="{x:Static local:Choices.Styles}"
                                Padding="6,2" VerticalAlignment="Center" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <!-- 드롭다운(0~10)에서 고르거나, 숫자를 쳐 넣고 ↑↓로 다음 문항으로(엑셀처럼). -->
                <DataGridTemplateColumn Header="변형 수" Width="64">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <ComboBox Tag="Variants" IsEditable="True" ItemsSource="{x:Static local:Choices.Counts}"
                                Text="{Binding Variants, UpdateSourceTrigger=PropertyChanged}"
                                GotKeyboardFocus="VariantsBox_GotKeyboardFocus" Padding="6,2" VerticalAlignment="Center" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="상태" Width="62">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Status}" FontWeight="SemiBold" VerticalAlignment="Center">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource Muted}" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding Status}" Value="완료">
                                <Setter Property="Foreground" Value="#10B981" />
                              </DataTrigger>
                              <DataTrigger Binding="{Binding Status}" Value="만드는 중">
                                <Setter Property="Foreground" Value="{StaticResource Accent}" />
                              </DataTrigger>
                              <DataTrigger Binding="{Binding Status}" Value="실패">
                                <Setter Property="Foreground" Value="{StaticResource Danger}" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
              </DataGrid.Columns>
              <DataGrid.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="이 문항 다시 만들기" Click="Remake_Click" />
                </ContextMenu>
              </DataGrid.ContextMenu>
            </DataGrid>
          </Border>
        </DockPanel>
      </Border>

      <!-- ③ 결과 확인과 보관 -->
      <Border Grid.Column="4" Style="{StaticResource Card}">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
            <Border Style="{StaticResource StepBadge}">
              <TextBlock Text="3" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="결과 확인과 보관" Style="{StaticResource StepTitle}" />
          </StackPanel>
          <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Margin="0,0,0,12"
                     Text="체크한 문항이 ④ 시험지에 들어갑니다. 모아 두었다가 나중에 쓰려면 문항함에 보관하세요." />

          <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <UniformGrid Rows="1">
              <Button x:Name="ArchiveExamButton" Content="시험용으로 보관" Style="{StaticResource Primary}" Click="ArchiveExam_Click" Margin="0,0,6,0" Padding="8,11" />
              <Button x:Name="ArchivePracticeButton" Content="예상문제로 보관" Click="ArchivePractice_Click" Margin="0" FontWeight="SemiBold"
                      Foreground="{StaticResource Accent}" BorderBrush="{StaticResource Accent}" />
            </UniformGrid>
          </StackPanel>

          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="ResultList">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                          CornerRadius="10" Padding="14,12" Margin="0,0,4,10">
                    <StackPanel>
                      <DockPanel Margin="0,0,0,8">
                        <Border DockPanel.Dock="Right" Style="{StaticResource Badge}" Background="{StaticResource AccentSoft}" Margin="6,0,0,0"
                                Visibility="{Binding ArchivedVisibility}">
                          <TextBlock Text="{Binding Archived}" Foreground="{StaticResource Accent}" FontSize="11.5" FontWeight="SemiBold" />
                        </Border>
                        <CheckBox IsChecked="{Binding Include}">
                          <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{StaticResource Accent}" />
                        </CheckBox>
                      </DockPanel>
                      <TextBlock Text="{Binding Top}" TextWrapping="Wrap" LineHeight="21" />
                      <Image Source="{Binding Image}" MaxWidth="320" MaxHeight="240" HorizontalAlignment="Left" Margin="0,8" />
                      <TextBlock Text="{Binding Bottom}" TextWrapping="Wrap" LineHeight="21" />
                      <Border Background="{StaticResource AccentSoft}" CornerRadius="8" Padding="10,8" Margin="0,10,0,0">
                        <TextBlock Text="{Binding Answer}" TextWrapping="Wrap" Foreground="{StaticResource Text2}" FontSize="12.5" LineHeight="19" />
                      </Border>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>

      <!-- ④ 시험지 -->
      <Border Grid.Column="6" Style="{StaticResource Card}">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
            <Border Style="{StaticResource StepBadge}">
              <TextBlock Text="4" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="시험지" Style="{StaticResource StepTitle}" />
          </StackPanel>
          <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Margin="0,0,0,10"
                     Text="③에서 체크한 문항이 자동으로 들어옵니다. 문항함에서 더 넣고 ↑↓로 순서를 정하세요." />
          <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <Button DockPanel.Dock="Right" Content="비우기" Click="ClearExam_Click" Margin="6,0,0,0" />
            <Button Content="문항함에서 넣기…" Click="AddFromBank_Click" Margin="0" />
          </DockPanel>

          <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <TextBlock x:Name="ExamSummary" Foreground="{StaticResource Text2}" FontWeight="SemiBold" Margin="2,0,0,8" />
            <Border Style="{StaticResource Panel}">
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                  </Grid.RowDefinitions>
                  <TextBlock Text="시험 이름" Style="{StaticResource Label}" Margin="0,0,8,8" />
                  <TextBox x:Name="TitleBox" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,0,0,8" />
                  <TextBlock Grid.Row="1" Text="과목" Style="{StaticResource Label}" Margin="0,0,8,8" />
                  <TextBox x:Name="SubjectBox" Grid.Row="1" Grid.Column="1" Margin="0,0,10,8" Text="과학" />
                  <TextBlock Grid.Row="1" Grid.Column="2" Text="학년" Style="{StaticResource Label}" Margin="0,0,8,8" />
                  <TextBox x:Name="GradeBox" Grid.Row="1" Grid.Column="3" Margin="0,0,0,8" />
                  <TextBlock Grid.Row="2" Text="일시" Style="{StaticResource Label}" Margin="0,0,8,8" />
                  <TextBox x:Name="DateBox" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,0,0,8" />
                  <TextBlock Grid.Row="3" Text="양식" Style="{StaticResource Label}" />
                  <DockPanel Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3">
                    <Button DockPanel.Dock="Right" Content="학습…" Click="LearnForm_Click" Margin="6,0,0,0" Padding="8,6" ToolTip="학교 시험지 양식(한글 파일)을 배워 목록에 넣습니다." />
                    <ComboBox x:Name="FormBox" DisplayMemberPath="Name" />
                  </DockPanel>
                </Grid>
                <WrapPanel Margin="0,10,0,0">
                  <CheckBox x:Name="PdfCheck" Content="PDF도" IsChecked="True" Margin="0,0,14,0" />
                  <CheckBox x:Name="AnswersCheck" Content="정답·해설지도" IsChecked="True" />
                </WrapPanel>
              </StackPanel>
            </Border>
            <Button x:Name="RenderButton" Content="시험지 만들기" Style="{StaticResource Primary}" Click="Render_Click" Margin="0,12,0,0" />
          </StackPanel>

          <Border BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10">
            <Grid>
              <ListBox x:Name="ExamList" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                  <Style TargetType="ListBoxItem">
                    <Setter Property="Template">
                      <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                          <Border x:Name="b" Background="Transparent" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="10,7">
                            <ContentPresenter />
                          </Border>
                          <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                              <Setter TargetName="b" Property="Background" Value="{StaticResource SoftBg}" />
                            </Trigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </Setter.Value>
                    </Setter>
                  </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <DockPanel>
                      <TextBlock DockPanel.Dock="Left" Text="{Binding Number}" FontWeight="Bold" Foreground="{StaticResource Accent}" Width="26" VerticalAlignment="Center" />
                      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="↑" Style="{StaticResource SmallButton}" Click="EntryUp_Click" Tag="{Binding}" ToolTip="앞으로" />
                        <Button Content="↓" Style="{StaticResource SmallButton}" Click="EntryDown_Click" Tag="{Binding}" ToolTip="뒤로" />
                        <Button Content="✕" Style="{StaticResource SmallButton}" Click="EntryRemove_Click" Tag="{Binding}" ToolTip="시험지에서 빼기" />
                      </StackPanel>
                      <StackPanel>
                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Sub}" Style="{StaticResource Hint}" FontSize="11.5" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                    </DockPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <TextBlock x:Name="ExamEmpty" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource Hint}" TextAlignment="Center"
                         Text="아직 넣은 문항이 없습니다." />
            </Grid>
          </Border>
        </DockPanel>
      </Border>
    </Grid>
  </DockPanel>
</Window>